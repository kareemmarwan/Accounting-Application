# انسخ هذا الملف إلى .env.local ثم ضع مفاتيح مشروعك من Supabase
# Settings → API → Project URL / anon publishable key / service_role secret key
# لا تضع service_role في أي كود متصفح — الخادم فقط

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# يُستخدم حصراً في Server Actions (دعوة الأعضاء)
SUPABASE_SERVICE_ROLE_KEY=
